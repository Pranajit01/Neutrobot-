# Port for the express backend
PORT=5001

# PostgreSQL connection string
# Fallback to local memory if this server is not reachable
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutrobot?schema=public"

# Redis connection string
# Fallback to local memory if this server is not reachable
REDIS_URL="redis://localhost:6379"

# JWT Token secret
JWT_SECRET="your-super-secret-key-change-this-in-production"

# Anthropic Claude API Key
# If omitted, the app will fall back to local rule-based heuristic calculations
ANTHROPIC_API_KEY=""
