datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  foodLogs  FoodLog[]
}

model FoodLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  query           String
  calories        Int
  protein         Float
  carbs           Float
  fat             Float
  fiber           Float
  deficiencies    String[]
  recommendations String[]
  createdAt       DateTime @default(now())
}
